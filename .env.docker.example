# Bilibili Wiki Docker 环境变量配置示例

# ==================== 本地 LLM 配置 ====================
LOCAL_LLM_BASE_URL=http://llm:8000/v1
LOCAL_LLM_API_KEY=your_llm_api_key_here
LOCAL_LLM_MODEL=qwen3.5-35b-a3b

# ==================== 本地 ASR 配置 ====================
LOCAL_ASR_BASE_URL=http://asr:8001/v1
LOCAL_ASR_API_KEY=your_asr_api_key_here
LOCAL_ASR_MODEL=whisper

# ==================== 本地 VLM 配置 ====================
LOCAL_VLM_BASE_URL=http://vlm:8002/v1
LOCAL_VLM_API_KEY=your_vlm_api_key_here
LOCAL_VLM_MODEL=qwen2.5-vl-72b-instruct

# ==================== 应用配置 ====================
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ==================== 数据库配置 ====================
DATABASE_URL=sqlite+aiosqlite:///./data/bilibili_rag.db

# ==================== Wiki 构建配置 ====================
WIKI_ENABLED=true
WIKI_DIR=./data/wiki
WIKI_SCHEMA=schema/BILIBILI_WIKI.md

# ==================== 视觉分析配置 ====================
VISION_ENABLED=false

# 视觉分析服务地址（如果与 VLM 不同可配置此处）
VISION_BASE_URL=http://vlm:8002/v1

# 视觉分析 API Key
VISION_API_KEY=your_vision_api_key_here

# 视觉分析模型名称
VISION_MODEL=Qwen3.5-VL

# 视觉分析超时时间（秒）
VISION_TIMEOUT=300

# 抽帧间隔（秒）
FRAME_INTERVAL=10

# 抽帧策略：keyframe(关键帧)/interval(定时)/sentence(基于ASR句子)
FRAME_STRATEGY=keyframe

# 最大分析视频时长（秒），超过将截断
MAX_VIDEO_DURATION=600

# 单视频最大关键帧数
MAX_FRAMES_PER_VIDEO=20

# ==================== B 站登录配置 ====================
# 通过扫码登录后，在浏览器中获取以下 Cookie
SESSDATA=your_sessdata_here
bili_jct=your_bili_jct_here
DedeUserID=your_dedeuserid_here

# ==================== Hugging Face Token (可选) ====================
# 如果使用 Hugging Face 下载模型
HUGGING_FACE_HUB_TOKEN=your_hf_token_here