# Bilibili Wiki 知识库系统 - 环境变量配置示例

# ==================== 应用配置 ====================
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ==================== 数据库配置 ====================
DATABASE_URL=sqlite+aiosqlite:///./data/bilibili_rag.db

# ==================== 大模型服务配置 (LLM/VLM/视觉分析共用) ====================
# 模型服务地址（兼容 OpenAI 格式）
LLM_BASE_URL=http://localhost:3000/v1

# 模型 API Key
LLM_API_KEY=your_api_key_here

# LLM 模型名称（用于文本生成和概念/实体提取）
LLM_MODEL=qwen3.5-35b-a3b

# VLM 模型名称（用于视觉分析和视频理解）
VLM_MODEL=qwen2.5-vl-72b-instruct

# ==================== 视觉分析配置 ====================
# 是否启用视觉分析
VISION_ENABLED=false

# 视觉分析超时时间（秒）
VISION_TIMEOUT=300

# 视觉分析专用模型名称
VISION_MODEL=Qwen3.5-VL

# ==================== 本地 ASR 配置 (语音识别) ====================
# ASR 服务地址（兼容 OpenAI 格式）
ASR_BASE_URL=http://localhost:1234/v1

# ASR API Key
ASR_API_KEY=your_asr_api_key_here

# ASR 模型名称
ASR_MODEL=whisper

# ASR 超时时间（秒）
ASR_TIMEOUT=600

# ==================== 视频抽帧配置 ====================
# 抽帧间隔（秒）
FRAME_INTERVAL=10

# 抽帧策略：keyframe(关键帧)/interval(定时)/sentence(基于ASR句子)
FRAME_STRATEGY=keyframe

# 最大分析视频时长（秒），超过将截断
MAX_VIDEO_DURATION=600

# 单视频最大关键帧数
MAX_FRAMES_PER_VIDEO=20

# ==================== Wiki 构建配置 ====================
# 是否启用 Wiki 构建模式
WIKI_ENABLED=true

# Wiki 存储目录
WIKI_DIR=./data/wiki

# Wiki 模式定义文件
WIKI_SCHEMA=schema/BILIBILI_WIKI.md

# ==================== B 站登录配置 ====================
# 通过扫码登录后，在浏览器中获取以下 Cookie
SESSDATA=your_sessdata_here
bili_jct=your_bili_jct_here
DedeUserID=your_dedeuserid_here

# ==================== 可选配置 ====================
# Hugging Face Token (如果使用 Hugging Face 下载模型)
# HUGGING_FACE_HUB_TOKEN=your_hf_token_here