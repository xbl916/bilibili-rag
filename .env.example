# Bilibili Wiki 知识库系统 - 环境变量配置示例

# ==================== 本地 LLM 配置 ====================
# 本地 vLLM 服务地址
LOCAL_LLM_BASE_URL=http://localhost:8000/v1

# 本地 LLM API Key
LOCAL_LLM_API_KEY=your_llm_api_key_here

# 本地 LLM 模型名称
LOCAL_LLM_MODEL=qwen3.5-35b-a3b

# ==================== 本地 ASR 配置 ====================
# 本地 ASR 服务地址（兼容 OpenAI 格式）
LOCAL_ASR_BASE_URL=http://localhost:1234/v1

# 本地 ASR API Key
LOCAL_ASR_API_KEY=your_asr_api_key_here

# 本地 ASR 模型名称
LOCAL_ASR_MODEL=whisper

# ASR 超时时间（秒）
ASR_TIMEOUT=600

# ==================== 本地 VLM 配置 ====================
# 本地 VLM 服务地址（兼容 OpenAI 格式）
LOCAL_VLM_BASE_URL=http://localhost:3000/v1

# 本地 VLM API Key
LOCAL_VLM_API_KEY=your_vlm_api_key_here

# 本地 VLM 模型名称
LOCAL_VLM_MODEL=qwen2.5-vl-72b-instruct

# 是否启用视觉分析
VISION_ENABLED=false

# 抽帧间隔（秒）
FRAME_INTERVAL=10

# 抽帧策略：keyframe(关键帧)/interval(定时)/smart(智能)
FRAME_STRATEGY=keyframe

# ==================== Wiki 构建配置 ====================
# 是否启用 Wiki 构建模式
WIKI_ENABLED=true

# Wiki 存储目录
WIKI_DIR=./data/wiki

# Wiki 模式定义文件
WIKI_SCHEMA=schema/BILIBILI_WIKI.md

# ==================== 应用配置 ====================
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ==================== 数据库配置 ====================
DATABASE_URL=sqlite+aiosqlite:///./data/bilibili_rag.db

# ==================== B 站登录配置 ====================
# 通过扫码登录后，在浏览器中获取以下 Cookie
SESSDATA=your_sessdata_here
bili_jct=your_bili_jct_here
DedeUserID=your_dedeuserid_here